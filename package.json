{
  "name": "web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "build": "vite-ssg build",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "simple-git-hooks",
    "preview": "vite preview",
    "test": "vitest run --globals",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.2",
    "@vueuse/core": "^15.0.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@gtm-support/vue-gtm": "^3.2.0",
    "@iconify/vue": "^5.0.3",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@rollup/pluginutils": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-link-attributes": "^3.0.5",
    "@types/node": "^24.19.2",
    "@unhead/schema-org": "^3.4.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/server-renderer": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "gray-matter": "^4.0.3",
    "happy-dom": "^21.0.4",
    "lint-staged": "^17.6.0",
    "markdown-it": "^14.3.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-prism": "^4.0.0",
    "prismjs": "^1.30.0",
    "rollup": "^4.64.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-markdown": "^32.1.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vite-ssg": "^28.3.0",
    "vite-ssg-sitemap": "^0.10.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit $1",
    "pre-commit": "pnpm exec lint-staged --allow-empty"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,vue,json,md,yml,yaml}": [
      "eslint --fix"
    ]
  }
}
